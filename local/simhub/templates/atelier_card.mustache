{{!
    @template local_simhub/atelier_card

    Carte atelier étudiante (§5.3), utilisée par toutes les sections de l'accueil (§5.1).

    Context variables required for this template:
    * numero, nomcourt, discipline, espece, dureeindicative
    * statutpersolabel, estindisponible, commentaireindispo
    * estcommence, estvalide
    * urllocalisation, urlressources, urlcommencer, urlterminer

    Example context (json):
    {
        "numero": "CH-012",
        "nomcourt": "Suture cutanée",
        "discipline": "Chirurgie",
        "espece": "Chien",
        "dureeindicative": 20,
        "statutpersolabel": "Pas commencé",
        "estindisponible": false,
        "commentaireindispo": "",
        "retourprevu": "",
        "estcommence": false,
        "estvalide": false,
        "urllocalisation": "#",
        "urlressources": "#",
        "urlcommencer": "#",
        "urlterminer": "#",
        "strings": {
            "boutonlocalisation": "Voir où il est",
            "boutonressources": "Voir les ressources",
            "boutoncommencer": "Commencer",
            "boutonterminer": "Terminer l'atelier et s'auto-évaluer"
        }
    }
}}
<div class="card local-simhub-carte mb-3 {{#estindisponible}}border-warning{{/estindisponible}}">
    <div class="card-body">
        <h5 class="card-title">
            <span class="text-muted">#{{numero}}</span> {{nomcourt}}
            <span class="badge badge-{{#estindisponible}}warning{{/estindisponible}}{{^estindisponible}}success{{/estindisponible}} float-right float-end">
                {{statutpersolabel}}
            </span>
        </h5>
        <p class="card-text">
            {{#categorie}}<span class="badge badge-secondary bg-secondary">{{categorie}}</span> {{/categorie}}
            {{discipline}} {{#espece}}&middot; {{espece}}{{/espece}}
            {{#dureeindicative}}&middot; {{dureeindicative}} min{{/dureeindicative}}
        </p>
        {{#ucs}}<p class="small text-muted mb-1">{{strings.ucassociees}} {{ucs}}</p>{{/ucs}}
        {{#estindisponible}}
            <p class="text-warning mb-1">{{commentaireindispo}}</p>
            {{#retourprevu}}<p class="small text-muted">{{retourprevu}}</p>{{/retourprevu}}
        {{/estindisponible}}
        <div class="btn-group" role="group">
            <a class="btn btn-outline-secondary btn-sm" href="{{urllocalisation}}">{{strings.boutonlocalisation}}</a>
            <a class="btn btn-outline-secondary btn-sm" href="{{urlressources}}">{{strings.boutonressources}}</a>
            {{#estcommence}}
                <a class="btn btn-primary btn-sm" href="{{urlterminer}}">{{strings.boutonterminer}}</a>
            {{/estcommence}}
            {{^estcommence}}
                {{^estindisponible}}
                    {{^estvalide}}
                        <a class="btn btn-primary btn-sm" href="{{urlcommencer}}">{{strings.boutoncommencer}}</a>
                    {{/estvalide}}
                {{/estindisponible}}
            {{/estcommence}}
        </div>
    </div>
</div>
