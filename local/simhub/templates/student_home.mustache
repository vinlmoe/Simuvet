{{!
    @template local_simhub/student_home

    Accueil étudiant personnalisé (§5) : filtres + liste de cartes atelier.

    Context variables required for this template:
    * title, ateliers, hasateliers, nomessage, formurl, filtre, strings
}}
<div class="local-simhub-studenthome">
    <form method="get" action="{{formurl}}" class="local-simhub-filtres form-inline mb-3">
        <div class="form-group mr-2 mb-2">
            <input type="text" name="motcle" class="form-control" placeholder="{{strings.filtremotcle}}"
                   value="{{filtre.motcle}}">
        </div>
        <div class="form-group mr-2 mb-2">
            <input type="text" name="discipline" class="form-control" placeholder="{{strings.filtrediscipline}}"
                   value="{{filtre.discipline}}">
        </div>
        <div class="form-group mr-2 mb-2">
            <input type="text" name="espece" class="form-control" placeholder="{{strings.filtreespece}}"
                   value="{{filtre.espece}}">
        </div>
        <div class="form-group mr-2 mb-2">
            <select name="niveaudifficulte" class="form-control">
                <option value="">{{strings.filtreniveau}}</option>
                <option value="facile">Facile</option>
                <option value="intermediaire">Intermédiaire</option>
                <option value="avance">Avancé</option>
            </select>
        </div>
        <div class="form-group mr-2 mb-2">
            <input type="number" name="dureemax" class="form-control" placeholder="{{strings.filtreduree}}"
                   value="{{filtre.dureemax}}" min="0">
        </div>
        <div class="form-group mb-2">
            <button type="submit" class="btn btn-primary mr-1">{{strings.filtreappliquer}}</button>
            <a href="{{formurl}}" class="btn btn-secondary">{{strings.filtrereinitialiser}}</a>
        </div>
    </form>

    {{^hasateliers}}
        <div class="alert alert-info">{{nomessage}}</div>
    {{/hasateliers}}

    <div class="local-simhub-cartes">
        {{#ateliers}}
        <div class="card local-simhub-carte mb-3 {{#estindisponible}}border-warning{{/estindisponible}}">
            <div class="card-body">
                <h5 class="card-title">
                    <span class="text-muted">#{{numero}}</span> {{nomcourt}}
                    <span class="badge badge-{{#estindisponible}}warning{{/estindisponible}}{{^estindisponible}}success{{/estindisponible}} float-right">
                        {{statutpersolabel}}
                    </span>
                </h5>
                <p class="card-text">
                    {{discipline}} {{#espece}}&middot; {{espece}}{{/espece}}
                    {{#dureeindicative}}&middot; {{dureeindicative}} min{{/dureeindicative}}
                </p>
                {{#estindisponible}}
                    <p class="text-warning">{{commentaireindispo}}</p>
                {{/estindisponible}}
                <div class="btn-group" role="group">
                    <a class="btn btn-outline-secondary btn-sm" href="{{urllocalisation}}">{{strings.boutonlocalisation}}</a>
                    <a class="btn btn-outline-secondary btn-sm" href="{{urlressources}}">{{strings.boutonressources}}</a>
                    {{#estcommence}}
                        <a class="btn btn-primary btn-sm" href="{{urlterminer}}">{{strings.boutonterminer}}</a>
                    {{/estcommence}}
                    {{^estcommence}}
                        {{^estindisponible}}
                            <a class="btn btn-primary btn-sm" href="{{urlcommencer}}">{{strings.boutoncommencer}}</a>
                        {{/estindisponible}}
                    {{/estcommence}}
                </div>
            </div>
        </div>
        {{/ateliers}}
    </div>
</div>
