{{!
    @template local_simhub/student_home

    Accueil étudiant personnalisé (§5.1) : sept sections construites sur le même modèle de
    carte atelier (§5.3) - à faire pour mes UC, mes parcours en cours, parcours ASV,
    ateliers commencés, ateliers à reprendre, recommandés pour mon groupe (cohorte Moodle
    choisie directement par le gestionnaire), et la liste complète avec filtres (§5.2).

    Context variables required for this template:
    * title, strings
    * mesuc, hasmesuc
    * parcoursencours, hasparcoursencours
    * asvtotal, asvvalides, hasasv, urlasv
    * commences, hascommences
    * areprendre, hasareprendre
    * recommandesgroupe, hasrecommandesgroupe
    * ateliers, hasateliers, nomessage, formurl, filtre
}}
<div class="local-simhub-studenthome">

    {{#hasmesuc}}
    <h4>{{strings.sectionmesuc}}</h4>
    <div class="local-simhub-cartes mb-4">
        {{#mesuc}}{{> local_simhub/atelier_card }}{{/mesuc}}
    </div>
    {{/hasmesuc}}

    {{#hasparcoursencours}}
    <h4>{{strings.sectionparcours}}</h4>
    <ul class="list-unstyled mb-4">
        {{#parcoursencours}}
        <li><a href="{{url}}">{{nom}}</a> — {{pct}} %
            {{#echeance}}<span class="small {{#enretard}}text-danger{{/enretard}}{{^enretard}}text-muted{{/enretard}}"> · {{strings.prochaineecheance}} {{echeance}}</span>{{/echeance}}
        </li>
        {{/parcoursencours}}
    </ul>
    {{/hasparcoursencours}}

    {{#hasasv}}
    <h4>{{strings.sectionasv}}</h4>
    <p class="mb-4"><a href="{{urlasv}}">{{strings.voirasv}}</a> — {{asvvalides}} / {{asvtotal}}</p>
    {{/hasasv}}

    {{#hascommences}}
    <h4>{{strings.sectioncommences}}</h4>
    <div class="local-simhub-cartes mb-4">
        {{#commences}}{{> local_simhub/atelier_card }}{{/commences}}
    </div>
    {{/hascommences}}

    {{#hasareprendre}}
    <h4>{{strings.sectionareprendre}}</h4>
    <div class="local-simhub-cartes mb-4">
        {{#areprendre}}{{> local_simhub/atelier_card }}{{/areprendre}}
    </div>
    {{/hasareprendre}}

    {{#hasrecommandesgroupe}}
    <h4>{{strings.sectionrecommandes}}</h4>
    <div class="local-simhub-cartes mb-4">
        {{#recommandesgroupe}}{{> local_simhub/atelier_card }}{{/recommandesgroupe}}
    </div>
    {{/hasrecommandesgroupe}}

    <h4>{{strings.sectiontous}}</h4>

    <form method="get" action="{{formurl}}" class="local-simhub-filtres form-inline mb-3">
        <div class="form-group mr-2 mb-2">
            <input type="text" name="motcle" class="form-control" placeholder="{{strings.filtremotcle}}"
                   value="{{filtre.motcle}}">
        </div>
        <div class="form-group mr-2 mb-2">
            <select name="discipline" class="form-control" aria-label="{{strings.filtrediscipline}}">
                <option value="">{{strings.filtrediscipline}}</option>
                {{#disciplines}}
                <option value="{{value}}"{{#selected}} selected{{/selected}}>{{value}}</option>
                {{/disciplines}}
            </select>
        </div>
        <div class="form-group mr-2 mb-2">
            <select name="espece" class="form-control" aria-label="{{strings.filtreespece}}">
                <option value="">{{strings.filtreespece}}</option>
                {{#especes}}
                <option value="{{value}}"{{#selected}} selected{{/selected}}>{{value}}</option>
                {{/especes}}
            </select>
        </div>
        <div class="form-group mr-2 mb-2">
            <select name="niveaudifficulte" class="form-control">
                <option value="">{{strings.filtreniveau}}</option>
                {{#niveaux}}
                <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
                {{/niveaux}}
            </select>
        </div>
        <div class="form-group mr-2 mb-2">
            <input type="number" name="dureemax" class="form-control" placeholder="{{strings.filtreduree}}"
                   value="{{filtre.dureemax}}" min="0">
        </div>
        <div class="form-group mr-2 mb-2">
            <select name="anneeetude" class="form-control">
                <option value="">{{strings.filtreannee}}</option>
                {{#anneeoptions}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/anneeoptions}}
            </select>
        </div>
        <div class="form-group mb-2">
            <button type="submit" class="btn btn-primary mr-1">{{strings.filtreappliquer}}</button>
            <a href="{{formurl}}" class="btn btn-secondary">{{strings.filtrereinitialiser}}</a>
        </div>
    </form>

    {{^hasateliers}}
        <div class="alert alert-info">{{nomessage}}</div>
    {{/hasateliers}}

    <div class="local-simhub-cartes">
        {{#ateliers}}{{> local_simhub/atelier_card }}{{/ateliers}}
    </div>
</div>
