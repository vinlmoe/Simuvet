      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="atelierid_fk" TYPE="foreign-unique" FIELDS="atelierid" REFTABLE="local_simhub_atelier" REFFIELDS="id"/>
