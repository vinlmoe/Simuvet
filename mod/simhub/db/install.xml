<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/simhub/db" VERSION="20260929" COMMENT="Activité SimHub d'une UC"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="simhub" COMMENT="Une instance par UC : porte le parcours d'ateliers de l'UC">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="100" COMMENT="Note maximale ; la note vaut le pourcentage d'avancement rapporté à ce maximum"/>
        <FIELD NAME="completionparcours" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="Achèvement quand tous les ateliers requis de l'UC sont réalisés"/>
        <FIELD NAME="parcoursid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="local_simhub_parcours de l'UC"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="parcoursid" TYPE="foreign" FIELDS="parcoursid" REFTABLE="local_simhub_parcours" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
